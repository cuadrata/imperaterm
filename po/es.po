#: src/imperaterm.c:1454
msgid ""
"Usage: imperaterm [--separate] [-e command [arguments]]\n"
"  -e command   run the command, not the shell, in the first tab\n"
"  --separate   be an Imperaterm of its own, not a window of the one that "
"runs\n"
"  --version    print the version"
msgstr ""
"Uso: imperaterm [--separate] [-e comando [argumentos]]\n"
"  -e comando   ejecuta el comando, y no el intérprete, en la primera "
"pestaña\n"
"  --separate   es un Imperaterm aparte, no una ventana del que ya se "
"ejecuta\n"
"  --version    muestra la versión"

