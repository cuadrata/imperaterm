#: src/imperaterm.c:1454
msgid ""
"Usage: imperaterm [--separate] [-e command [arguments]]\n"
"  -e command   run the command, not the shell, in the first tab\n"
"  --separate   be an Imperaterm of its own, not a window of the one that "
"runs\n"
"  --version    print the version"
msgstr ""
"Aufruf: imperaterm [--separate] [-e Befehl [Argumente]]\n"
"  -e Befehl    im ersten Reiter den Befehl statt der Shell ausführen\n"
"  --separate   ein eigenes Imperaterm sein, kein Fenster des laufenden\n"
"  --version    die Version ausgeben"

