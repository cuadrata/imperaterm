#: src/imperaterm.c:1454
msgid ""
"Usage: imperaterm [--separate] [-e command [arguments]]\n"
"  -e command   run the command, not the shell, in the first tab\n"
"  --separate   be an Imperaterm of its own, not a window of the one that "
"runs\n"
"  --version    print the version"
msgstr ""
"Usage : imperaterm [--separate] [-e commande [arguments]]\n"
"  -e commande  exécute la commande, et non le shell, dans le premier onglet\n"
"  --separate   est un Imperaterm à part, et non une fenêtre de celui qui "
"tourne\n"
"  --version    affiche la version"

